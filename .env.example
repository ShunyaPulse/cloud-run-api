# ─── Environment Variables ───────────────────────────────────────────
# Copy this file to .env and fill in real values (for local dev only).
# In production (Cloud Run), these are injected via --set-env-vars.

# Neon Serverless Postgres connection string
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/dbname?sslmode=require

# Server port (Cloud Run injects PORT automatically; default 8080)
PORT=8080
